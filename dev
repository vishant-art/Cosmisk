#!/usr/bin/env bash
# Cosmisk full-stack dev container helper.
# Runs the whole monorepo (Angular UI + Fastify API + Python ai-layer) with hot
# reload inside one container, backed by your remote Neon DB.
# Run from repo root. Requires: docker, docker compose plugin.

set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="${REPO_ROOT}/.devcontainer/docker-compose.dev.yml"
SERVICE="cosmisk-dev"

WEB_URL="https://localhost:4200"   # ng serve uses a self-signed cert in this repo
API_URL="http://localhost:3000"
AI_URL="http://localhost:8077"

dc()        { docker compose -f "${COMPOSE_FILE}" "$@"; }
dexec()     { dc exec -T "${SERVICE}" "$@"; }
dexec_tty() { dc exec "${SERVICE}" "$@"; }
# Detached in-container start. `docker compose exec -d` hangs on some Compose
# builds (seen with v2.39-desktop on WSL2 — the detach never returns), so use
# plain `docker exec -d` against the pinned container_name (== SERVICE). This
# reparents the process to the container's init, so it survives this exec
# returning.
ddetach()   { docker exec -d "${SERVICE}" "$@"; }

# True on first run (or after volumes are wiped): deps/venv not yet installed.
needs_bootstrap() {
  ! dexec test -x /workspace/cos/bin/python \
    || ! dexec test -d /workspace/apps/api/node_modules/fastify \
    || ! dexec test -d /workspace/node_modules/@angular
}

cmd_up() {
  dc up -d --build
  if needs_bootstrap; then
    echo "==> First run: bootstrapping deps + venv + apps/api/.env (~5-8 min)"
    dexec bash -lc 'bash /workspace/.devcontainer/post-create.sh'
  fi
  cmd_start
}

cmd_down() {
  dc down
}

# Start all three services, each detached (docker exec -d survives the exec
# session; a plain `&` would be SIGKILLed when the exec exits). Each logs to its
# own file inside the container.
cmd_start() {
  echo "==> Starting ai-layer (uvicorn --reload) -> ${AI_URL}"
  dexec bash -lc 'pkill -f "[u]vicorn ai_layer.api:app" 2>/dev/null || true; sleep 0.3'
  ddetach bash -lc 'cd /workspace/apps/ai-layer && exec /workspace/cos/bin/python -m uvicorn ai_layer.api:app --host 0.0.0.0 --port 8077 --reload > /tmp/ai-layer.log 2>&1'

  echo "==> Starting API (tsx watch)            -> ${API_URL}"
  dexec bash -lc 'pkill -f "[t]sx watch src/index.ts" 2>/dev/null || true; sleep 0.3'
  ddetach bash -lc 'cd /workspace/apps/api && exec npx tsx watch src/index.ts > /tmp/api.log 2>&1'

  echo "==> Starting Web (ng serve)             -> ${WEB_URL}"
  dexec bash -lc 'pkill -f "[n]g serve" 2>/dev/null || true; sleep 0.3'
  ddetach bash -lc 'cd /workspace/apps/web && exec npx ng serve --host 0.0.0.0 --port 4200 > /tmp/web.log 2>&1'

  echo -n "    waiting for API /health"
  local api_ok=0
  for _ in $(seq 1 40); do
    if curl -sf "${API_URL}/health" >/dev/null 2>&1; then api_ok=1; echo " — up"; break; fi
    echo -n "."; sleep 1
  done
  [ "${api_ok}" = 1 ] || { echo " — TIMED OUT"; echo "   tail /tmp/api.log:"; dexec bash -lc 'tail -40 /tmp/api.log 2>/dev/null || true'; }

  echo -n "    waiting for Web (ng compile, can take ~60s)"
  local web_ok=0
  for _ in $(seq 1 90); do
    if curl -skf -o /dev/null "${WEB_URL}" 2>/dev/null; then web_ok=1; echo " — up"; break; fi
    echo -n "."; sleep 1
  done
  [ "${web_ok}" = 1 ] || { echo " — not ready yet"; echo "   check './dev logs web' — ng serve may still be compiling"; }

  echo
  echo "==> Open the UI:  ${WEB_URL}"
  echo "    API:          ${API_URL}      AI layer docs: ${AI_URL}/docs"
  echo "    No DATABASE_URL? data routes 500 — see apps/api/.env, then './dev migrate'"
}

cmd_stop() {
  dexec bash -lc '
    pkill -f "[n]g serve" 2>/dev/null || true
    pkill -f "[t]sx watch src/index.ts" 2>/dev/null || true
    pkill -f "[u]vicorn ai_layer.api:app" 2>/dev/null || true
    echo "    all three services stopped"
  '
}

cmd_restart() {
  cmd_stop || true
  cmd_start
}

cmd_migrate() {
  echo "==> drizzle migrate against Neon (uses MIGRATION_DATABASE_URL / DATABASE_URL from apps/api/.env)"
  dexec bash -lc 'cd /workspace/apps/api && npm run db:migrate'
}

cmd_logs() {
  local which="${1:-all}"
  case "${which}" in
    api) dexec_tty bash -lc 'tail -F /tmp/api.log' ;;
    web) dexec_tty bash -lc 'tail -F /tmp/web.log' ;;
    ai|ai-layer) dexec_tty bash -lc 'tail -F /tmp/ai-layer.log' ;;
    all) dexec_tty bash -lc 'tail -F /tmp/api.log /tmp/web.log /tmp/ai-layer.log' ;;
    *) echo "usage: ./dev logs [api|web|ai|all]"; return 1 ;;
  esac
}

cmd_shell() {
  dexec_tty bash -l
}

cmd_status() {
  echo "==> Container:"
  dc ps
  echo
  echo "==> Service processes:"
  dexec bash -lc 'pgrep -af "[n]g serve"               || echo "  web:      (not running)"'
  dexec bash -lc 'pgrep -af "[t]sx watch src/index.ts" || echo "  api:      (not running)"'
  dexec bash -lc 'pgrep -af "[u]vicorn ai_layer.api"   || echo "  ai-layer: (not running)"'
  echo
  echo "==> Health:"
  curl -sf "${API_URL}/health" && echo || echo "  API:  (no response on :3000)"
  curl -skf -o /dev/null -w "  Web:  HTTP %{http_code} on :4200 (https)\n" "${WEB_URL}" 2>/dev/null || echo "  Web:  (no response on :4200)"
  echo
}

cmd_test() {
  dexec bash -lc 'cd /workspace/apps/api && npm test'
}

cmd_help() {
  cat <<EOF
Cosmisk full-stack dev container

Usage: ./dev <command>

Lifecycle:
  up               build image, bootstrap (first run), start all three services
  down             stop and remove the container (named volumes persist)
  start            (re)start web + api + ai-layer inside the container
  stop             stop the three services (container keeps running)
  restart          stop + start

Database (Neon):
  migrate          run drizzle migrations against your Neon DB (opt-in)

Inspection:
  status           container + the three processes + /health + :4200
  logs [svc]       tail logs; svc = api | web | ai | all (default all)
  shell            bash shell inside the container

  test             run the apps/api vitest suite

URLs:  UI ${WEB_URL}   API ${API_URL}   AI layer ${AI_URL}/docs

First time: set Neon DATABASE_URL + MIGRATION_DATABASE_URL in apps/api/.env,
then './dev migrate'. To reach /app/dashboard, sign up at the UI and set
onboarding_complete=1 (and role='admin') for your user in Neon.
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  up)            cmd_up "$@" ;;
  down)          cmd_down "$@" ;;
  start)         cmd_start "$@" ;;
  stop)          cmd_stop "$@" ;;
  restart)       cmd_restart "$@" ;;
  migrate)       cmd_migrate "$@" ;;
  logs)          cmd_logs "$@" ;;
  shell)         cmd_shell "$@" ;;
  status)        cmd_status "$@" ;;
  test)          cmd_test "$@" ;;
  help|-h|--help) cmd_help ;;
  *)
    echo "unknown command: $cmd"
    echo
    cmd_help
    exit 1
    ;;
esac
