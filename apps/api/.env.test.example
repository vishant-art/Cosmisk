# Test environment template — copy to .env.test and fill in.
# .env.test is gitignored; NEVER commit real secrets (the repo is public).
# Rotate any key that was ever committed.

NODE_ENV=test
PORT=
APP_URL=
FRONTEND_URL=

# Database (use an isolated test branch / local Postgres — never prod)
TEST_DATABASE_URL=
DATABASE_PATH=

# Auth / crypto
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# LLM / AI
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NANO_BANANA_API_KEY=
FLUX_API_KEY=
HEYGEN_API_KEY=
KLING_API_KEY=
CREATIFY_API_KEY=
ELEVENLABS_API_KEY=

# Meta
META_APP_ID=
META_APP_SECRET=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=

# TikTok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Billing — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# Billing — Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Slack
SLACK_WEBHOOK_URL=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Email / webhooks
RESEND_API_KEY=
ALERT_EMAIL_FROM=
N8N_VIDEO_WEBHOOK=
