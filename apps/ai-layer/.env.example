# Cosmisk ai-layer (FastAPI) — runtime env vars.
# REQUIRED:
DATABASE_URL=
MIGRATION_DATABASE_URL=
AI_LAYER_API_KEY=
# Generation providers (add manually at demo — billed):
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
FAL_KEY=
# Connector credentials:
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Apify (competitor ad scraping -- apify/facebook-ads-scraper actor; billed pay-per-result):
APIFY_TOKEN=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Tuning:
CONNECTOR_CACHE_TTL_S=3600

# --- Object storage (Cloudflare R2, vendor-neutral S3) ---
# Empty STORAGE_BUCKET = storage OFF -> generated media stays on local disk (dev only;
# 404s after a Railway redeploy). Set all five (from the R2 S3 API token) in prod.
# MUST match the values on the apps/api service (same bucket).
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
# Optional key prefix (single-tenant demo leaves empty; per-tenant later).
STORAGE_PREFIX=
