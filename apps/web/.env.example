# Cosmisk web (Angular). These are BUILD-TIME values consumed by
# scripts/apply-env.mjs (prebuild/prestart) — set them in the Vercel dashboard.
# Only API_BASE_URL is required; META_OAUTH_ENABLED is optional (demo fail-safe).
API_BASE_URL=https://your-railway-api-domain
META_OAUTH_ENABLED=false
# META_APP_ID is a committed constant in env-config.default.ts (public, not an env var).
