# ═══════════════════════════════════════════════════════════════════════
# Cosmisk — consolidated env reference (local dev "all-in-one").
# Split-deploy: each service reads ONLY its section. In prod set a section on
# that service (apps/api→Railway A, ai-layer→Railway B, web→Vercel). The Python
# services walk up to find this root .env in local dev.
# Dummy values only — real values live in the untracked .env (never committed).
# ═══════════════════════════════════════════════════════════════════════

# ─────────── shared (multiple services) ───────────
DATABASE_URL=your_pooled_neon_url                  # apps/api + ai-layer
MIGRATION_DATABASE_URL=your_direct_neon_url         # apps/api + ai-layer
META_ACCESS_TOKEN=your_meta_access_token            # apps/api + ai-layer + connectors
AI_LAYER_API_KEY=your_shared_ai_layer_key           # apps/api sends · ai-layer validates

# ─────────── apps/api (TS backend — Railway A) ───────────
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_32_bytes
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_32_bytes
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# ─────────── apps/ai-layer (Python FastAPI — Railway B) ───────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=your_openrouter_base_url
FAL_KEY=your_fal_key
FAL_ADMIN_KEY=your_fal_admin_key                    # optional; billing read only
# Object storage (Cloudflare R2, vendor-neutral S3). Empty STORAGE_BUCKET = OFF.
STORAGE_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_r2_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key
STORAGE_BUCKET=your_r2_bucket
STORAGE_REGION=auto
STORAGE_PREFIX=

# ─────────── apps/connectors (Python — imported by ai-layer) ───────────
SHOPIFY_SHOP_DOMAIN=your_shop.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_ADMIN_TOKEN=your_shopify_admin_token
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_ads_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_google_ads_login_customer_id   # optional

# ═══════════════════════════════════════════════════════════════════════
# DEAD — read by NO code (verify, then delete)
# ═══════════════════════════════════════════════════════════════════════
# DATABASE_PATH=          # SQLite retired (Neon only)
# CLOUDFLARE_ACCOUNT_ID=  # no reader (R2 uses STORAGE_* above)
# CLOUDFLARE_API_TOKEN=   # no reader

# ═══════════════════════════════════════════════════════════════════════
# MISSING — code reads these, root doesn't document them (verify, then add)
# ═══════════════════════════════════════════════════════════════════════
# apps/ai-layer direct reads (NOTE the name drift vs the connectors section above):
# META_AD_ACCOUNT=your_meta_ad_account            # ai-layer creative; connectors uses META_AD_ACCOUNT_ID
# SHOPIFY_STORE=your_shop.myshopify.com            # ai-layer creative; connectors uses SHOPIFY_SHOP_DOMAIN
# SHOPIFY_TOKEN=your_shopify_admin_token           # ai-layer creative; connectors uses SHOPIFY_ADMIN_TOKEN
# SHOPIFY_API_VERSION=2026-07
# AI_LAYER_STORE_PATH=your_store_sqlite_path       # defaults to data/store.sqlite
# CREATIVE_OUTPUT_DIR=your_creative_output_dir     # defaults to data/creative_output
# CONNECTOR_CACHE_TTL_S=900
#
# apps/api (documented in apps/api/.env.example; here for the all-in-one):
# META_AD_ACCOUNT_ID=your_meta_ad_account_id
# TEST_DATABASE_URL=your_test_neon_url
# ANTHROPIC_TIER=1
# LLM_DAILY_USD_CAP_OVERRIDE_CENTS=
# DEMO_ACCOUNT_ID=your_demo_account_id
# GOOGLE_AI_API_KEY=your_google_ai_api_key
# SENTRY_DSN=your_sentry_dsn
# N8N_HOST=your_n8n_host
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# FLUX_API_KEY=your_flux_api_key
# CREATIFY_API_KEY=your_creatify_api_key
# HEYGEN_API_KEY=your_heygen_api_key
# KLING_API_KEY=your_kling_api_key
# TIKTOK_APP_ID=your_tiktok_app_id
# TIKTOK_APP_SECRET=your_tiktok_app_secret
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
# SHOPIFY_API_KEY=your_shopify_api_key
# SHOPIFY_API_SECRET=your_shopify_api_secret
# SHOPIFY_SHOP=your_shop.myshopify.com
