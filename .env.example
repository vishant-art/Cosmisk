# --- Creative Studio experiment (rnd/creative) -------------------------------
# Brain (BrandKit + concepts) reuses OPENROUTER_API_KEY above. Fill the rest:
# Image: Nano Banana 2 + Video: Veo 3.1  (https://aistudio.google.com/apikey, needs billing)
GEMINI_API_KEY=
# Image fallback: FLUX.2 + Video fallback: Seedance 2.0  (https://fal.ai/dashboard/keys, needs credits)
FAL_KEY=
# ADMIN-scoped key, ONLY for reading account balance/usage (GET /v1/account/billing).
# Separate from FAL_KEY so the render path never carries admin scope. Optional.
FAL_ADMIN_KEY=
# FREE image path: Cloudflare Workers AI, FLUX.1 schnell, no card  (--image-provider cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

#Google ad connections
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
#optional
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Object storage (Cloudflare R2, vendor-neutral S3) ---
# Empty STORAGE_BUCKET = storage OFF -> generated media stays on local disk (dev only;
# 404s after a Railway redeploy). Set all five (from the R2 S3 API token) in prod.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
# Optional key prefix (single-tenant demo leaves empty; per-tenant later).
STORAGE_PREFIX=